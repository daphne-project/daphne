rule buildSharedLib
  command = g++ -shared $in -o $out
build libDummy2.so: buildSharedLib dummy2.o

rule compileSrc
  command = g++ -c -fPIC $in -I../../../../../../src -std=gnu++20 -o $out
build dummy2.o: compileSrc dummy2.cpp
